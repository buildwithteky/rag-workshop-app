{
  "LambdaFunctionConfigurations": [
    {
      "Id": "rag-workshop-ingest-sync-created",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:<ACCOUNT_ID>:function:rag-workshop-ingest-sync",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            { "Name": "prefix", "Value": "users/" }
          ]
        }
      }
    },
    {
      "Id": "rag-workshop-ingest-sync-removed",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:<ACCOUNT_ID>:function:rag-workshop-ingest-sync",
      "Events": ["s3:ObjectRemoved:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            { "Name": "prefix", "Value": "users/" }
          ]
        }
      }
    }
  ]
}
