{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3UserScopedAccess",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::rag-workshop-docs-<ACCOUNT_ID>/users/*"
    },
    {
      "Sid": "DynamoDbDocumentsTable",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/rag-workshop-documents"
    },
    {
      "Sid": "BedrockIngestionControl",
      "Effect": "Allow",
      "Action": [
        "bedrock:StartIngestionJob",
        "bedrock:GetIngestionJob",
        "bedrock:ListIngestionJobs",
        "bedrock:GetKnowledgeBaseDocuments"
      ],
      "Resource": "arn:aws:bedrock:us-east-1:<ACCOUNT_ID>:knowledge-base/<KNOWLEDGE_BASE_ID>"
    }
  ]
}
