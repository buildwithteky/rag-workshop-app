# Chat Lambda (rag-workshop-ask) environment variables
KNOWLEDGE_BASE_ID=your-knowledge-base-id
DOCUMENTS_TABLE=rag-workshop-documents
GENERATION_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0
NUMBER_OF_RESULTS=4
ALLOWED_ORIGIN=*
LOG_LEVEL=INFO
MAX_QUESTION_LENGTH=1000

# Documents-upload Lambda environment variables
DOCS_BUCKET=rag-workshop-docs-your-account-id
MAX_FILE_SIZE_BYTES=10485760
PRESIGN_EXPIRY_SECONDS=300

# Documents-manage Lambda environment variables
# (uses DOCS_BUCKET, DOCUMENTS_TABLE, ALLOWED_ORIGIN, LOG_LEVEL above)

# Ingest-sync Lambda environment variables
DATA_SOURCE_ID=your-data-source-id
# (also uses DOCS_BUCKET, DOCUMENTS_TABLE, KNOWLEDGE_BASE_ID above)

# These are illustrative defaults only — never commit real values, and never hard-code
# AWS access keys, secret keys, or session tokens anywhere in source code.
